@page
@model TodoSecure.Pages.Tasks.DeleteModel
@{ ViewData["Title"] = "Удаление задачи"; }

<h2>Удалить задачу?</h2>
<p><strong>@Model.Task?.Title</strong></p>

<form method="post">
    <input type="hidden" name="id" value="@Model.Task?.Id" />
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a asp-page="Index" class="btn btn-outline-secondary">Отмена</a>
</form>