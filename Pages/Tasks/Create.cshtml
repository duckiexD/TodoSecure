@page
@model TodoSecure.Pages.Tasks.CreateModel
@{ ViewData["Title"] = "Создать задачу"; }

<h2>Создать задачу</h2>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div>
        <label asp-for="Input.Title">Заголовок</label>
        <input asp-for="Input.Title" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Input.Description">Описание</label>
        <textarea asp-for="Input.Description" rows="4"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-page="Index" class="btn btn-outline-secondary">Отмена</a>
</form>